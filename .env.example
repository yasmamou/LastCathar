# CesiumJS Ion Token (get yours at https://ion.cesium.com/)
NEXT_PUBLIC_CESIUM_ION_TOKEN=your_cesium_ion_token_here

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/lastcathar?schema=public"

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# OpenAI API (for agents)
OPENAI_API_KEY=your_openai_api_key_here

# Stripe (test mode)
# Server-side secret key (dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_here
# Publishable key (safe on client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_here
# Webhook signing secret (stripe listen or dashboard webhook config)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Price IDs created in Stripe dashboard for the two subscription plans
STRIPE_PRICE_SINGLE=price_id_for_single_slot_50eur
STRIPE_PRICE_PACK_10=price_id_for_pack_10_slots_400eur
# Pass Audioguides (paiement unique 5 €)
STRIPE_PRICE_AUDIO=price_id_for_audio_pass_5eur
