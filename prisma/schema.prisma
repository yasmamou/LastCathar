generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime? @map("email_verified")
  hashedPassword String?   @map("hashed_password")
  image          String?
  role           UserRole  @default(EXPLORER)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  accounts       Account[]
  sessions       Session[]
  interactions   UserPlaceInteraction[]
  contributions  UserContribution[]
  products       Product[]
  subscriptions  Subscription[]
  epicProgress   UserEpicProgress[]
  badges         UserBadge[]
  xp             UserXP?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  EXPLORER
  SELLER
  ADMIN
}

// ─── Explorer interactions ───────────────────────────────────────

model UserPlaceInteraction {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  placeSlug String          @map("place_slug")
  type      InteractionType
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeSlug, type])
  @@map("user_place_interactions")
  @@index([placeSlug])
}

enum InteractionType {
  VISITED
  WISHLIST
  FAVORITE
}

// ─── User contributions (moderated) ─────────────────────────────

model UserContribution {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  placeSlug   String?         @map("place_slug")
  type        ContributionType
  title       String?
  description String?         @db.Text
  imageUrls   String[]        @map("image_urls")
  latitude    Float?
  longitude   Float?
  status      ModerationState @default(REVIEW)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_contributions")
  @@index([userId])
  @@index([placeSlug])
  @@index([status])
}

enum ContributionType {
  PHOTO
  PLACE
  STORY
}

// ─── Marketplace ─────────────────────────────────────────────────

model PlaceSlot {
  id           String @id @default(cuid())
  placeSlug    String @map("place_slug")
  maxSlots     Int    @default(4) @map("max_slots")
  pricePerMonth Int   @default(50) @map("price_per_month")

  products Product[]

  @@unique([placeSlug])
  @@map("place_slots")
}

model Product {
  id          String          @id @default(cuid())
  sellerId    String          @map("seller_id")
  placeSlotId String          @map("place_slot_id")
  title       String
  description String?         @db.Text
  price       String?
  imageUrls   String[]        @map("image_urls")
  externalUrl String?         @map("external_url")
  status      ModerationState @default(REVIEW)
  views       Int             @default(0)
  clicks      Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  seller    User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  placeSlot PlaceSlot @relation(fields: [placeSlotId], references: [id], onDelete: Cascade)

  @@map("products")
  @@index([sellerId])
  @@index([placeSlotId])
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String             @map("user_id")
  plan             SubscriptionPlan
  status           SubscriptionStatus @default(ACTIVE)
  slotsIncluded    Int                @map("slots_included")
  stripeCustomerId String?            @map("stripe_customer_id")
  stripeSubId      String?            @unique @map("stripe_sub_id")
  stripePriceId    String?            @map("stripe_price_id")
  currentPeriodEnd DateTime?          @map("current_period_end")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
  @@index([userId])
  @@index([stripeCustomerId])
}

enum SubscriptionPlan {
  SINGLE
  PACK_10
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  EXPIRED
}

// ─── Analytics ───────────────────────────────────────────────────

model PlaceView {
  id        String   @id @default(cuid())
  placeSlug String   @map("place_slug")
  productId String?  @map("product_id")
  event     ViewEvent
  createdAt DateTime @default(now()) @map("created_at")

  @@map("place_views")
  @@index([placeSlug])
  @@index([productId])
  @@index([createdAt])
}

enum ViewEvent {
  PLACE_OPEN
  PRODUCT_VIEW
  PRODUCT_CLICK
}

// ─── Places (existing) ──────────────────────────────────────────

model PlaceEntry {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  alternateNames      String[] @map("alternate_names")
  shortDescription    String   @map("short_description")
  fullStory           String   @map("full_story") @db.Text
  latitude            Float
  longitude           Float
  region              String?
  country             String
  continent           String
  locationPrecision   LocationPrecision @default(APPROXIMATE) @map("location_precision")
  geometryType        GeometryType @default(POINT) @map("geometry_type")
  categoryPrimary     String   @map("category_primary")
  categorySecondary   String[] @map("category_secondary")
  tags                String[]
  era                 String[]
  statusBadge         String   @map("status_badge")
  confidenceLevel     ConfidenceLevel @default(SPECULATIVE) @map("confidence_level")
  evidenceType        String[] @map("evidence_type")
  sourceSummary       String?  @map("source_summary") @db.Text
  sourceLinks         String[] @map("source_links")
  imageUrls           String[] @map("image_urls")
  heroImageUrl        String?  @map("hero_image_url")
  thumbnailUrl        String?  @map("thumbnail_url")
  travelInterestScore Int      @default(0) @map("travel_interest_score")
  mysteryScore        Int      @default(0) @map("mystery_score")
  historicalScore     Int      @default(0) @map("historical_score")
  architectureScore   Int      @default(0) @map("architecture_score")
  tourismScore        Int      @default(0) @map("tourism_score")
  localLegendScore    Int      @default(0) @map("local_legend_score")
  isFeatured          Boolean  @default(false) @map("is_featured")
  isVerified          Boolean  @default(false) @map("is_verified")
  moderationState     ModerationState @default(REVIEW) @map("moderation_state")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  sources       Source[]
  images        ImageAsset[]
  relatedFrom   RelatedPlace[] @relation("relatedFrom")
  relatedTo     RelatedPlace[] @relation("relatedTo")

  @@map("place_entries")
  @@index([latitude, longitude])
  @@index([categoryPrimary])
  @@index([confidenceLevel])
  @@index([country])
  @@index([moderationState])
}

model Source {
  id               String   @id @default(cuid())
  placeEntryId     String   @map("place_entry_id")
  sourceType       String   @map("source_type")
  title            String?
  url              String?
  publisher        String?
  datePublished    String?  @map("date_published")
  snippet          String?  @db.Text
  reliabilityScore Int      @default(50) @map("reliability_score")
  notes            String?  @db.Text

  placeEntry PlaceEntry @relation(fields: [placeEntryId], references: [id], onDelete: Cascade)

  @@map("sources")
  @@index([placeEntryId])
}

model ImageAsset {
  id              String  @id @default(cuid())
  placeEntryId    String  @map("place_entry_id")
  url             String
  licenseType     String? @map("license_type")
  attributionText String? @map("attribution_text")
  sourceUrl       String? @map("source_url")
  isHero          Boolean @default(false) @map("is_hero")
  sortOrder       Int     @default(0) @map("sort_order")

  placeEntry PlaceEntry @relation(fields: [placeEntryId], references: [id], onDelete: Cascade)

  @@map("image_assets")
  @@index([placeEntryId])
}

model RelatedPlace {
  id          String @id @default(cuid())
  fromPlaceId String @map("from_place_id")
  toPlaceId   String @map("to_place_id")
  relationship String?

  fromPlace PlaceEntry @relation("relatedFrom", fields: [fromPlaceId], references: [id], onDelete: Cascade)
  toPlace   PlaceEntry @relation("relatedTo", fields: [toPlaceId], references: [id], onDelete: Cascade)

  @@unique([fromPlaceId, toPlaceId])
  @@map("related_places")
}

enum LocationPrecision {
  EXACT
  APPROXIMATE
  REGION_LEVEL
  UNKNOWN
}

enum GeometryType {
  POINT
  AREA
  ZONE
}

enum ConfidenceLevel {
  LEGENDARY
  SPECULATIVE
  PLAUSIBLE
  DOCUMENTED
  CONFIRMED
}

enum ModerationState {
  DRAFT
  REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

// ─── Chercheur Mode (gamification) ──────────────────────────────

model UserEpicProgress {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  epicId         String    @map("epic_id")
  currentOrder   Int       @default(1) @map("current_order")
  visitedSlugs   String[]  @map("visited_slugs")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, epicId])
  @@map("user_epic_progress")
  @@index([userId])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  badgeSlug String   @map("badge_slug")
  earnedAt  DateTime @default(now()) @map("earned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeSlug])
  @@map("user_badges")
  @@index([userId])
}

model UserXP {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  xp        Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_xp")
}
