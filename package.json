  "scripts": {
    "cesium:copy": "rm -rf public/cesium && mkdir -p public/cesium && cp -r node_modules/cesium/Build/Cesium/Workers public/cesium/ && cp -r node_modules/cesium/Build/Cesium/ThirdParty public/cesium/ && cp -r node_modules/cesium/Build/Cesium/Assets public/cesium/ && cp -r node_modules/cesium/Build/Cesium/Widgets public/cesium/",
    "postinstall": "prisma generate && npm run cesium:copy",
    "dev": "next dev",
    "build": "prisma generate && npm run cesium:copy && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "seed:export": "npx tsx scripts/export-seed-json.ts",
    "remotion:preview": "npx remotion preview remotion/index.tsx",
    "remotion:render": "npx remotion render remotion/index.tsx RoisBerberes out/rois-berberes.mp4",
    "seed:cathar": "npx tsx scripts/seed-cathar.ts",
    "stripe:setup": "npx tsx scripts/setup-stripe.ts",
    "check:epics": "npx tsx scripts/check-epics.ts",
    "audio:guides": "./scripts/generate-audio-guides.sh"
  },
